@@ -118,6 +118,14 @@ def convert(source: Path, destination: Path) -> dict:
         if path.is_symlink() or not path.is_file():
             reject(path, "unsafe_archive_path", "Review and copy manually after resolving the link")
             continue
+        parts = relative.parts
+        if (parts[:2] in {("history", "pending-delete"), ("history", "operation-receipts")}
