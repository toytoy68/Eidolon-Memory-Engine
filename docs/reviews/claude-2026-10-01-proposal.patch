--- /dev/null
+++ b/tests/test_audit_fixes_2026_10_01.py
@@ -0,0 +1,106 @@
+"""Regression tests for the 2026-10-01 audit findings E-005 and E-006 (Claude proposal)."""
+from dataclasses import replace
+
+import pytest
+
+from core.backend.filesystem import FilesystemBackend
+from core.backend.models import Memory
+from core.events.filesystem import FilesystemEventRepository
+from core.information.writes import FilesystemInformationWrites
+from core.migration.converter import convert
+from core.migration.inventory import inventory
+from core.operations.errors import OperationConflict
+from core.operations.filesystem import FilesystemOperationRepository
+from core.operations.models import OperationStatus
+from core.operations.thread_status import FilesystemThreadOperations
+from core.threads.models import Thread, ThreadStatus
+from core.threads.storage import ThreadStorage
+
+META = {"type": "FACT", "epistemic_status": "UNVERIFIED", "operational_state": "ACTIVE",
+        "confidence": "LOW", "importance": "NORMAL", "retention": "NORMAL"}
+
+
+def write(writes, number, event=None):
+    return writes.create(
+        Memory(f"info-{number}", content=f"content {number}", metadata=dict(META)),
+        operation_id=f"op-{number}", event_id=event or f"ev-{number}",
+        actor="tester", timestamp="2026-10-01T00:00:00Z")
+
+
+def test_failed_thread_status_operation_is_reported_blocked_not_skipped(tmp_path, monkeypatch):
+    storage = ThreadStorage(tmp_path / "memory/persistent")
+    history = tmp_path / "memory/history"
+    operations = FilesystemOperationRepository(history / "operations/thread-status-v1")
+    events = FilesystemEventRepository(history / "events/thread-status-v1")
+    storage.create(Thread("t1", "T", "O", created_at="2026-10-01", updated_at="2026-10-01"))
+    writer = FilesystemThreadOperations(storage, events, operations)
+    update = operations.update
+
+    def interrupted(operation):
+        raise RuntimeError("interrupted before APPLYING")
+
+    monkeypatch.setattr(operations, "update", interrupted)
+    with pytest.raises(RuntimeError, match="interrupted"):
+        writer.change_status("t1", ThreadStatus.VALIDATED, previous_revision=1,
+                             operation_id="o1", event_id="e1")
+    monkeypatch.setattr(operations, "update", update)
+    operations.update(replace(operations.get("o1"), status=OperationStatus.FAILED))
+    assert writer.recover() == {"o1": {"status": "BLOCKED", "error": "FAILED"}}
+
+
+def test_inventory_sees_a_corrupt_thread_delete_journal(tmp_path):
+    (tmp_path / "memory/persistent").mkdir(parents=True)
+    journal = tmp_path / "memory/history/operations/thread-delete-v1"
+    journal.mkdir(parents=True)
+    (journal / "broken.json").write_text("{not json", encoding="utf-8")
+    review = inventory(tmp_path)["needs_review"]
+    assert {"path": "memory/history/operations/thread-delete-v1/broken.json",
+            "reason": "unreadable_or_invalid"} in review
+
+
+def test_inventory_flags_an_unknown_history_directory(tmp_path):
+    (tmp_path / "memory/persistent").mkdir(parents=True)
+    (tmp_path / "memory/history/operations/future-family-v9").mkdir(parents=True)
+    assert {"path": "memory/history/operations/future-family-v9",
+            "reason": "unknown_history_directory"} in inventory(tmp_path)["needs_review"]
+
+
+def test_inventory_accepts_a_valid_empty_core_layout(tmp_path):
+    backend = FilesystemBackend(tmp_path / "memory/persistent", tmp_path / "memory/history")
+    write(FilesystemInformationWrites(backend), 1)
+    assert inventory(tmp_path)["needs_review"] == []
+
+
+def test_conversion_rejects_a_deleted_receipt_instead_of_releasing_the_identity(tmp_path):
+    source = tmp_path / "source"
+    backend = FilesystemBackend(source / "memory/persistent", source / "memory/history")
+    backend.store(Memory("info-gone", content="x"))
+    backend.delete_request("info-gone", "tester", "test", 1, "delete-1")
+    backend.approve_delete("info-gone", "delete-1")
+    report = convert(source, tmp_path / "destination")
+    assert [(item["file"], item["reason"]) for item in report["rejected"]] == [
+        ("memory/history/pending-delete/info-gone.json", "operational_state_requires_import_policy")]
+    assert not (tmp_path / "destination/archive/history/pending-delete/info-gone.json").exists()
+
+
+def test_compacted_event_id_stays_reserved_and_receipts_are_not_pending_work(tmp_path):
+    backend = FilesystemBackend(tmp_path / "persistent", tmp_path / "history")
+    writes = FilesystemInformationWrites(backend)
+    write(writes, 1, event="shared-event")
+    writes.compact("op-1")
+    assert writes.journal.uncompacted_ids() == []
+    with pytest.raises(OperationConflict, match="event_id"):
+        write(writes, 2, event="shared-event")
+    assert backend.get("info-2") is None
+
+
+def test_compacted_operations_do_not_count_as_pending(tmp_path):
+    backend = FilesystemBackend(tmp_path / "persistent", tmp_path / "history")
+    writes = FilesystemInformationWrites(backend)
+    write(writes, 1)
+    writes.compact("op-1")
+    updated = writes.update(
+        Memory("info-1", revision=1, content="changed", metadata=dict(META)),
+        previous_revision=1, operation_id="op-1b", event_id="ev-1b",
+        actor="tester", timestamp="2026-10-01T00:00:01Z")
+    assert updated["revision"] == 2
