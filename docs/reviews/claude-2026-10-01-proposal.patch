diff --git a/core/information/write_journal.py b/core/information/write_journal.py
index ffc8e81..e1fd48e 100644
--- a/core/information/write_journal.py
+++ b/core/information/write_journal.py
@@ -71,6 +71,39 @@ class InformationWriteJournal:
         return sorted({p.stem for root in (self.operations_root, self.receipts_root)
                        for p in root.glob('*.json')})
 
+    def uncompacted_ids(self):
+        """Operations that still have a full plan on disk.
+
+        A compact receipt is always COMMITTED, so receipts can never be pending
+        work. Scans that look for pending operations can skip them; the cost is
+        then bounded by uncompacted operations instead of the whole history.
+        Receipts are still read by ``receipt_event_ids`` and by full audits.
+        """
+        self._check_roots()
+        return sorted(p.stem for p in self.operations_root.glob('*.json'))
+
+    def receipt_event_ids(self):
+        """Event ids reserved by compact receipts, read without full validation.
+
+        A receipt keeps reserving its event_id even if the Event file is later
+        lost, so this cannot be replaced by an Event repository lookup. Only the
+        event_id field is parsed here; ``read``/audits remain the validators.
+        """
+        self._check_roots()
+        found = set()
+        if self.receipts_root.is_dir():
+            for path in self.receipts_root.glob('*.json'):
+                try:
+                    if path.is_symlink():
+                        raise ValueError('compact receipt is a symlink')
+                    value = decode_json_value(path.read_text(encoding='utf-8')).get('event_id')
+                    if not isinstance(value, str):
+                        raise ValueError('compact receipt without event_id')
+                except (OSError, UnicodeError, ValueError, AttributeError, TypeError) as exc:
+                    raise OperationConflict('invalid compact receipt') from exc
+                found.add(value)
+        return found
+
     def receipt_path(self, operation_id):
         return self.receipts_root / self.operations._path(operation_id).name
 
