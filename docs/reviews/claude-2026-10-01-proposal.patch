+def unknown_history_entries(root: Path) -> list[dict]:
+    """Fail closed: report history sub-directories that no SOURCES entry covers."""
+    known = {Path(relative).as_posix() for _, relative, _ in SOURCES}
+    parents = {Path(relative).parent.as_posix() for _, relative, _ in SOURCES}
+    found = []
+    for base in sorted(parents | {"memory/history"}):
+        directory = root / base
+        if directory.is_symlink() or not directory.is_dir():
+            continue
+        for child in sorted(directory.iterdir()):
+            relative = child.relative_to(root).as_posix()
+            if child.is_dir() and not child.is_symlink() and relative not in known and relative not in parents:
+                found.append({"path": relative, "reason": "unknown_history_directory"})
+    return found
+
