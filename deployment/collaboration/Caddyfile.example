# Fichier     : deployment/collaboration/Caddyfile.example
# Description : Configuration Caddyfile.example
# Standard    : Eidolon Presentation Standard v1
# ==========================================================

collaboration.example.org {
    # The exact discovery path below is the path generated by the SDK.
    @allowed path /mcp /.well-known/oauth-protected-resource/mcp
    handle @allowed {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:8765
    }
    handle {
        respond "Not found" 404
    }
}
